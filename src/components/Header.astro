---
import { GITHUB, SITE_TAGLINE, SITE_TITLE } from '../consts';

const links = [
	{ href: '/', label: '首页' },
	{ href: '/archives/', label: '归档' },
	{ href: '/tags/', label: '标签' },
	{ href: '/about/', label: '关于' },
];

const { pathname } = Astro.url;
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header>
	<div class="site">
		<a class="title" href="/">{SITE_TITLE}<span class="dot"> · blog</span></a>
		<p class="tagline">{SITE_TAGLINE}</p>
	</div>
	<nav>
		{links.map((l) => <a href={l.href} class={isActive(l.href) ? 'active' : ''}>{l.label}</a>)}
		<a href={GITHUB} target="_blank" rel="noopener" aria-label="GitHub">
			<svg viewBox="0 0 16 16" aria-hidden="true" width="17" height="17">
				<path
					fill="currentColor"
					d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
				></path>
			</svg>
		</a>
		<a href="/rss.xml" aria-label="RSS 订阅">
			<svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" fill="currentColor">
				<path
					d="M4 11a9 9 0 0 1 9 9h3A12 12 0 0 0 4 8v3zm0-7a16 16 0 0 1 16 16h3A19 19 0 0 0 4 1v3zm2 13a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z"
				></path>
			</svg>
		</a>
		<button id="theme-toggle" aria-label="切换深浅色">
			<svg class="moon" viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" fill="currentColor">
				<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
			</svg>
			<svg class="sun" viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" fill="currentColor">
				<circle cx="12" cy="12" r="4.5"></circle>
				<path
					d="M12 2v2.5m0 15V22M4.9 4.9l1.8 1.8m10.6 10.6 1.8 1.8M2 12h2.5m15.5 0H22M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
					stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"
				></path>
			</svg>
		</button>
	</nav>
</header>

<script>
	const btn = document.querySelector('#theme-toggle');
	btn?.addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {
			/* ignore */
		}
	});
</script>

<style>
	header {
		max-width: 720px;
		margin: 0 auto;
		padding: 3.2rem 1.25rem 0;
		text-align: center;
	}
	.title {
		font-size: 1.8rem;
		font-weight: 700;
		color: var(--text);
		letter-spacing: 0.02em;
	}
	.title:hover {
		color: var(--accent);
	}
	.dot {
		color: var(--muted);
		font-weight: 400;
		font-size: 0.85em;
	}
	.tagline {
		color: var(--muted);
		margin: 0.35em 0 1.8em;
		font-size: 0.92rem;
		letter-spacing: 0.12em;
	}
	nav {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 1.5rem;
		padding: 0.7em 0;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}
	nav a {
		color: var(--muted);
		font-size: 0.95rem;
		display: inline-flex;
		align-items: center;
	}
	nav a:hover,
	nav a.active {
		color: var(--accent);
	}
</style>
