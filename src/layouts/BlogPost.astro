---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { postUrl } from '../utils';

interface Props {
	post: CollectionEntry<'blog'>;
	prev?: CollectionEntry<'blog'>; // 更早一篇
	next?: CollectionEntry<'blog'>; // 更晚一篇
}

const { post, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage } = post.data;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={`${title} · ${SITE_TITLE}`} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="post-header">
					<h1>{title}</h1>
					<div class="meta">
						<FormattedDate date={pubDate} />
						{
							tags.length > 0 && (
								<span class="tags">
									{tags.map((t) => (
										<a href={`/tags/${t}/`}>#{t}</a>
									))}
								</span>
							)
						}
					</div>
				</header>

				{heroImage && <Image width={1020} height={510} src={heroImage} alt="" class="hero" />}

				<div class="prose">
					<slot />
				</div>

				{updatedDate && <p class="updated">最后更新于 <FormattedDate date={updatedDate} /></p>}

				<nav class="post-nav">
					{prev ? <a href={postUrl(prev)} rel="prev">← {prev.data.title}</a> : <span></span>}
					{next ? <a href={postUrl(next)} rel="next">{next.data.title} →</a> : <span></span>}
				</nav>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-header {
		text-align: center;
		margin-bottom: 1rem;
	}
	.post-header h1 {
		margin-bottom: 0.5em;
	}
	.meta {
		color: var(--muted);
		font-size: 0.88rem;
		display: flex;
		justify-content: center;
		gap: 1.2em;
		flex-wrap: wrap;
	}
	.tags a {
		color: var(--muted);
		margin-right: 0.5em;
	}
	.tags a:hover {
		color: var(--accent);
	}
	.hero {
		width: 100%;
		margin: 1.5rem 0 0;
		border-radius: 10px;
	}
	.prose {
		margin-top: 2.2rem;
	}
	.updated {
		text-align: center;
		color: var(--muted);
		font-size: 0.85rem;
		font-style: italic;
		margin-top: 2.5rem;
	}
	.post-nav {
		display: flex;
		justify-content: space-between;
		gap: 1em;
		margin-top: 3rem;
		padding-top: 1.2rem;
		border-top: 1px solid var(--border);
		font-size: 0.9rem;
	}
	.post-nav a {
		color: var(--muted);
		max-width: 48%;
	}
	.post-nav a:hover {
		color: var(--accent);
	}
</style>
