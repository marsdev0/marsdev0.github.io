---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { postUrl } from '../utils';

interface Props {
	post: CollectionEntry<'blog'>;
	prev?: CollectionEntry<'blog'>; // 更早一篇
	next?: CollectionEntry<'blog'>; // 更晚一篇
}

const { post, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage } = post.data;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={`${title} · ${SITE_TITLE}`} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="post-header">
					<h1>{title}</h1>
					<div class="meta">
						<FormattedDate date={pubDate} />
						{
							tags.length > 0 && (
								<span class="tags">
									{tags.map((t) => (
										<a href={`/tags/${t}/`}>#{t}</a>
									))}
								</span>
							)
						}
					</div>
				</header>

				{heroImage && <Image width={1020} height={510} src={heroImage} alt="" class="hero" />}

				<div class="prose">
					<slot />
				</div>

				{updatedDate && <p class="updated">最后更新于 <FormattedDate date={updatedDate} /></p>}

				<nav class="post-nav">
					{prev ? <a href={postUrl(prev)} rel="prev">← {prev.data.title}</a> : <span></span>}
					{next ? <a href={postUrl(next)} rel="next">{next.data.title} →</a> : <span></span>}
				</nav>
			</article>
		</main>
		<Footer />

		<!-- 正文图片：点击放大查看（对整图式设计图很有用） -->
		<script>
			// 从 srcset 里取最大的一份，放大后才清晰
			function largestSrc(img: HTMLImageElement): string {
				let best = img.currentSrc || img.src;
				let bestW = 0;
				for (const part of (img.getAttribute('srcset') || '').split(',')) {
					const [url, desc] = part.trim().split(/\s+/);
					if (!url) continue;
					const w = desc && desc.endsWith('w') ? parseInt(desc, 10) : 0;
					if (w >= bestW) {
						bestW = w;
						best = new URL(url, location.href).href;
					}
				}
				return best;
			}

			function openLightbox(img: HTMLImageElement) {
				const overlay = document.createElement('div');
				overlay.className = 'lightbox';
				const big = document.createElement('img');
				big.src = largestSrc(img);
				big.alt = img.alt;
				overlay.appendChild(big);
				document.body.appendChild(overlay);
				document.body.style.overflow = 'hidden';

				const close = () => {
					overlay.remove();
				document.body.style.overflow = '';
				document.removeEventListener('keydown', onKey);
				};
				const onKey = (e: KeyboardEvent) => {
					if (e.key === 'Escape') close();
				};
				overlay.addEventListener('click', close);
				document.addEventListener('keydown', onKey);
			}

			document.addEventListener('click', (e) => {
				const target = e.target as HTMLElement | null;
				const img = target?.closest?.('.prose img') as HTMLImageElement | null;
				if (img) openLightbox(img);
			});
		</script>
	</body>
</html>

<style>
	.post-header {
		text-align: center;
		margin-bottom: 1rem;
	}
	.post-header h1 {
		margin-bottom: 0.5em;
	}
	.meta {
		color: var(--muted);
		font-size: 0.88rem;
		display: flex;
		justify-content: center;
		gap: 1.2em;
		flex-wrap: wrap;
	}
	.tags a {
		color: var(--muted);
		margin-right: 0.5em;
	}
	.tags a:hover {
		color: var(--accent);
	}
	.hero {
		width: 100%;
		margin: 1.5rem 0 0;
		border-radius: 10px;
	}
	.prose {
		margin-top: 2.2rem;
	}
	.updated {
		text-align: center;
		color: var(--muted);
		font-size: 0.85rem;
		font-style: italic;
		margin-top: 2.5rem;
	}
	.post-nav {
		display: flex;
		justify-content: space-between;
		gap: 1em;
		margin-top: 3rem;
		padding-top: 1.2rem;
		border-top: 1px solid var(--border);
		font-size: 0.9rem;
	}
	.post-nav a {
		color: var(--muted);
		max-width: 48%;
	}
	.post-nav a:hover {
		color: var(--accent);
	}
</style>

<style is:global>
	/* 灯箱：运行时由 JS 创建、图片来自 markdown，必须用全局样式 */
	.prose img {
		cursor: zoom-in;
	}
	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 999;
		background: rgba(16, 15, 13, 0.9);
		overflow: auto;
		display: flex;
		padding: 2rem;
		cursor: zoom-out;
	}
	.lightbox img {
		margin: auto; /* 小图居中，大图可滚动浏览 */
		max-width: none;
		border-radius: 4px;
		box-shadow: 0 10px 50px rgba(0, 0, 0, 0.55);
	}
</style>
