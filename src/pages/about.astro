---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { AUTHOR, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`关于 · ${SITE_TITLE}`} description={`关于 ${AUTHOR} 和这个博客`} />
	</head>
	<body>
		<Header />
		<main>
			<div class="prose">
				<h2>你好，我是 {AUTHOR}</h2>
				<p>
					后端 + AI 工程师，平时写代码、读点书、记录一些想法。
					这个博客用来放两类东西：<strong>技术笔记</strong>和<strong>生活随笔</strong>。
				</p>
				<p>
					我相信「写下来，才算真正想清楚」。很多问题在脑子里的时候是糊的，
					落到纸面上就不得不变成清楚的句子。所以这里首先写给自己，如果能顺便对你有点用，那就更好了。
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
