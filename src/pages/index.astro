---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { formatDate, postUrl, sortPosts } from '../utils';

const posts = sortPosts(await getCollection('blog'));
const recent = posts.slice(0, 8);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${SITE_TITLE} · blog`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="post-list">
				{
					recent.map((post) => (
						<a class="row" href={postUrl(post)}>
							<div class="row-main">
								<span class="date">{formatDate(post.data.pubDate)}</span>
								<span class="t">{post.data.title}</span>
								{post.data.description && <span class="desc">{post.data.description}</span>}
							</div>
							{post.data.thumb && (
								<Image src={post.data.thumb} alt="" width={96} height={96} class="thumb" />
							)}
						</a>
					))
				}
			</section>
			{
				posts.length > recent.length && (
					<p class="more">
						<a href="/archives/">全部文章（{posts.length} 篇）→</a>
					</p>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-list {
		margin-top: 1rem;
	}
	.row {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		padding: 1.05em 0;
		border-bottom: 1px solid var(--border);
	}
	.row-main {
		flex: 1;
		min-width: 0;
	}
	.row .date {
		color: var(--muted);
		font-size: 0.82rem;
		font-family: var(--font-mono);
	}
	.row .t {
		display: block;
		font-size: 1.12rem;
		font-weight: 700;
		color: var(--text);
		margin-top: 0.15em;
	}
	.row:hover .t {
		color: var(--accent);
	}
	.row .desc {
		display: block;
		color: var(--muted);
		font-size: 0.9rem;
		margin-top: 0.2em;
	}
	.row .thumb {
		flex: none;
		width: 88px;
		height: 88px;
		object-fit: contain;
		background: #fff;
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 4px;
		box-sizing: border-box;
		transition: border-color 0.15s ease;
	}
	.row:hover .thumb {
		border-color: var(--accent);
	}
	.more {
		text-align: center;
		margin-top: 2rem;
		font-size: 0.9rem;
	}
</style>
