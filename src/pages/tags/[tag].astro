---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { formatDate, postUrl, sortPosts } from '../../utils';

export async function getStaticPaths() {
	const posts = sortPosts(await getCollection('blog'));
	const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
	return tags.map((tag) => ({
		params: { tag },
		props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
	}));
}

const { tag, posts } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`标签「${tag}」 · ${SITE_TITLE}`} description={`${SITE_TITLE} 中标签为 ${tag} 的文章`} />
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">#{tag} <span class="count">{posts.length} 篇</span></h1>
			<ul class="list">
				{
					posts.map((post) => (
						<li>
							<time>{formatDate(post.data.pubDate)}</time>
							<a href={postUrl(post)}>{post.data.title}</a>
						</li>
					))
				}
			</ul>
			<p class="back"><a href="/tags/">← 全部标签</a></p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-title {
		font-size: 1.4em;
	}
	.count {
		color: var(--muted);
		font-size: 0.7em;
		font-weight: 400;
	}
	.list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.list li {
		display: flex;
		gap: 1.2em;
		align-items: baseline;
		padding: 0.45em 0;
		border-bottom: 1px dashed var(--border);
	}
	.list time {
		color: var(--muted);
		font-size: 0.82rem;
		font-family: var(--font-mono);
		flex-shrink: 0;
	}
	.list a {
		color: var(--text);
	}
	.list a:hover {
		color: var(--accent);
	}
	.back {
		margin-top: 2rem;
		font-size: 0.9rem;
	}
</style>
